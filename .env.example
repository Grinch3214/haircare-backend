# Google-таблицы через Apps Script (см. MVP.MD, 4.3)
APPS_SCRIPT_URL=https://script.google.com/macros/s/<deployment-id>/exec
APPS_SCRIPT_SECRET=

# Postgres (docker-compose.yml)
POSTGRES_USER=haircare
POSTGRES_PASSWORD=haircare
POSTGRES_DB=haircare
POSTGRES_PORT=5432
DATABASE_URL=postgresql://haircare:haircare@localhost:5432/haircare

# Фронтенд (CORS, редирект после Google OAuth). На проде — домен сайта
CLIENT_URL=http://localhost:5173

# Бэкенд (callback Google OAuth, домен кук). На проде — домен API
SERVER_URL=http://localhost:3000
SERVER_DOMAIN=localhost

# Сид суперадмина (npm run db:seed). Только для локальной разработки
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# JWT. Секрет — случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
